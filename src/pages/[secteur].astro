---
import Base from '../layouts/Base.astro';
import SecteurNav from '../components/SecteurNav.astro';
import Concerts from '../components/Concerts.astro';
import { SECTEURS } from '../data/secteurs.js';
import data from '../data/events.json';

export function getStaticPaths() {
  return SECTEURS.map((s) => ({
    params: { secteur: s.slug },
    props: { secteur: s },
  }));
}

const { secteur } = Astro.props;
const events = data.events.filter((e) => e.secteur === secteur.slug);
---

<Base
  titre={`Concerts à ${secteur.nom} — agenda Morbihan`}
  description={`Les concerts à venir sur le secteur de ${secteur.nom} (Morbihan) : dates, lieux et billetterie.`}
>
  <section class="hero">
    <h1 class="hero-titre">Concerts à <em>{secteur.nom}</em>.</h1>
    <p class="hero-sous">
      {events.length > 0
        ? `${events.length} concert${events.length > 1 ? 's' : ''} à venir sur ce secteur.`
        : 'Aucun concert recensé sur ce secteur pour le moment.'}
    </p>
  </section>

  <SecteurNav actif={secteur.slug} />

  <h2 class="section-titre">À venir</h2>
  <Concerts events={events} />
</Base>
