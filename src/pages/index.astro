---
import Base from '../layouts/Base.astro';
import Concerts from '../components/Concerts.astro';
import Carte from '../components/Carte.astro';
import data from '../data/events.json';

// Bandeau défilant : noms d'artistes/concerts à venir.
const noms = data.events.slice(0, 16).map((e) => e.titre.split(/[:(]/)[0].trim().slice(0, 40));

const auj = new Date();
const dans7 = new Date(auj.getTime() + 7 * 864e5).toISOString().slice(0, 10);
const cetteSemaine = data.events.filter((e) => e.debut.slice(0, 10) <= dans7).length;
---

<Base
  titre="Concerts Morbihan — l'agenda des concerts à venir"
  description="Tous les concerts à venir dans le Morbihan : Vannes, Auray, Lorient, Erdeven, Étel, Quiberon. Dates, lieux et billetterie, mis à jour chaque jour."
>
  <section class="hero">
    <div>
      <p class="hero-eyebrow"><span class="etoile">✦</span> Concerts à venir · Morbihan</p>
      <h1 class="hero-title">
        Ce qui va<br />
        <span class="trait">faire</span> du<br />
        <span class="accent">bruit.</span>
      </h1>
      <p class="hero-sub">
        L'agenda des concerts du Morbihan — de Lorient à Vannes, en passant par
        Auray, Erdeven, Étel et Quiberon. <b>{data.total} dates</b> à venir,
        dont <b>{cetteSemaine} cette semaine</b>. Mis à jour chaque jour.
      </p>
    </div>

    <div class="hero-carte">
      <Carte actif={null} />
      <p class="hero-carte-aide">Choisissez un secteur sur la carte</p>
    </div>
  </section>

  {noms.length > 0 && (
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        <span>{noms.map((n) => <>{n}&nbsp;&nbsp;✦&nbsp;&nbsp;</>)}</span>
        <span>{noms.map((n) => <>{n}&nbsp;&nbsp;✦&nbsp;&nbsp;</>)}</span>
      </div>
    </div>
  )}

  <section class="section">
    <div class="section-head">
      <h2 class="section-title">Tous les concerts</h2>
      <span class="section-count">{data.total} dates à venir</span>
    </div>
    <Concerts events={data.events} />
  </section>
</Base>
