---
import Base from '../layouts/Base.astro';
import Concerts from '../components/Concerts.astro';
import EventsJsonLd from '../components/EventsJsonLd.astro';
import { SECTEURS } from '../data/secteurs.js';
import data from '../data/events.json';

// Bandeau défilant : noms d'artistes/concerts à venir.
const noms = data.events.slice(0, 16).map((e) => e.titre.split(/[:(]/)[0].trim().slice(0, 40));

const auj = new Date();
const dans7 = new Date(auj.getTime() + 7 * 864e5).toISOString().slice(0, 10);
const cetteSemaine = data.events.filter((e) => e.debut.slice(0, 10) <= dans7).length;
---

<Base
  titre="Concerts Morbihan — l'agenda des concerts à venir"
  description="Tous les concerts à venir dans le Morbihan : Vannes, Auray, Lorient, Erdeven, Étel, Quiberon. Dates, lieux et billetterie, mis à jour chaque jour."
>
  <EventsJsonLd events={data.events} />
  <section class="hero">
    <p class="hero-eyebrow"><span class="etoile">✦</span> Agenda des concerts · Morbihan</p>
    <h1 class="hero-title">
      Ce qui va <span class="trait">faire</span><br />
      du <span class="accent">bruit.</span>
    </h1>
    <p class="hero-sub">
      Tous les concerts à venir dans le Morbihan — de Lorient à Vannes, en
      passant par Auray, Erdeven, Étel et Quiberon. <b>{data.total} dates</b>
      à venir, dont <b>{cetteSemaine} cette semaine</b>. Mis à jour chaque jour.
    </p>
  </section>

  {noms.length > 0 && (
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        <span>{noms.map((n) => <>{n}&nbsp;&nbsp;✦&nbsp;&nbsp;</>)}</span>
        <span>{noms.map((n) => <>{n}&nbsp;&nbsp;✦&nbsp;&nbsp;</>)}</span>
      </div>
    </div>
  )}

  <section class="section">
    <div class="section-head">
      <h2 class="section-title">Tous les concerts</h2>
      <span class="section-count"><b id="f-count">{data.total}</b> dates affichées</span>
    </div>

    <div class="filtres">
      <label class="filtre">
        <span>Secteur</span>
        <select id="f-secteur">
          <option value="">Tous les secteurs</option>
          {SECTEURS.filter((s) => (data.par_secteur[s.slug] ?? 0) > 0).map((s) => (
            <option value={s.slug}>{s.nom} ({data.par_secteur[s.slug]})</option>
          ))}
        </select>
      </label>
      <label class="filtre">
        <span>Quand</span>
        <select id="f-quand">
          <option value="">N'importe quand</option>
          <option value="weekend">Ce week-end</option>
          <option value="semaine">Cette semaine (7 j)</option>
          <option value="mois">Ce mois-ci</option>
        </select>
      </label>
      <button id="f-reset" type="button" class="filtre-reset" hidden>Réinitialiser</button>
    </div>

    <Concerts events={data.events} />
    <p class="vide" id="f-vide" hidden>Aucun concert ne correspond à ces filtres.</p>
  </section>

  <script is:inline>
    // Initialise les filtres. Rebranché à chaque navigation via astro:page-load
    // (sinon le script inline ne se relance pas après une View Transition).
    function initFiltres() {
      const secteur = document.getElementById('f-secteur');
      const quand = document.getElementById('f-quand');
      const reset = document.getElementById('f-reset');
      const count = document.getElementById('f-count');
      const vide = document.getElementById('f-vide');
      if (!secteur || !quand) return; // pas sur la page d'accueil
      const cartes = [...document.querySelectorAll('.section .carte')];

      const jour = (d) => new Date(d.getFullYear(), d.getMonth(), d.getDate());
      const now = new Date();
      const auj = jour(now);

      function bornesQuand(v) {
        if (v === 'semaine') return [auj, new Date(auj.getTime() + 7 * 864e5)];
        if (v === 'mois') return [auj, new Date(now.getFullYear(), now.getMonth() + 1, 1)];
        if (v === 'weekend') {
          // Prochain samedi 00h → lundi 00h (ou ce week-end si on y est).
          const d = auj.getDay(); // 0=dim
          const versSam = (6 - d + 7) % 7;
          const sam = new Date(auj.getTime() + versSam * 864e5);
          return [sam, new Date(sam.getTime() + 2 * 864e5)];
        }
        return null;
      }

      function appliquer() {
        const s = secteur.value;
        const b = bornesQuand(quand.value);
        let n = 0;
        for (const c of cartes) {
          const okS = !s || c.dataset.secteur === s;
          let okD = true;
          if (b) { const t = new Date(c.dataset.debut); okD = t >= b[0] && t < b[1]; }
          const visible = okS && okD;
          c.style.display = visible ? '' : 'none';
          if (visible) n++;
        }
        count.textContent = n;
        vide.hidden = n > 0;
        reset.hidden = !s && !quand.value;
      }

      secteur.addEventListener('change', appliquer);
      quand.addEventListener('change', appliquer);
      reset.addEventListener('click', () => { secteur.value = ''; quand.value = ''; appliquer(); });
    }

    if (!window.__filtresBound) {
      window.__filtresBound = true;
      document.addEventListener('astro:page-load', initFiltres);
    }
  </script>
</Base>
