---
import SecteurBody from '../../components/pages/SecteurBody.astro';
import { SECTEURS } from '../../data/secteurs.js';

export function getStaticPaths() {
  return SECTEURS.map((s) => ({ params: { secteur: s.slug }, props: { secteur: s } }));
}
const { secteur } = Astro.props;
---
<SecteurBody lang="en" secteur={secteur} />
