---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  titre: string;
  description: string;
}
const { titre, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0b0f1a" />
  </head>
  <body>
    <header class="entete">
      <a href="/" class="marque">
        <span class="marque-pastille" aria-hidden="true"></span>
        Concerts <span class="marque-lieu">Morbihan</span>
      </a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pied">
      <div class="pied-inner">
        <p class="pied-titre">Concerts Morbihan</p>
        <p>
          Agenda indépendant des concerts à venir autour de Vannes, Auray,
          Lorient, Erdeven, Étel et Quiberon.
        </p>
        <p class="pied-sources">
          Données : agenda public <a href="https://openagenda.com" rel="noopener">OpenAgenda</a>,
          sites des salles &amp; <a href="https://www.fnacspectacles.com" rel="noopener">Fnac Spectacles</a>.
          Affiches © leurs ayants droit. Vérifiez dates &amp; billetterie auprès de l'organisateur.
        </p>
      </div>
    </footer>
  </body>
</html>
