---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SECTEURS } from '../data/secteurs.js';
import { t, prefix, otherLangPath } from '../i18n.js';
import data from '../data/events.json';

interface Props {
  titre: string;
  description: string;
  lang?: string;
}
const { titre, description, lang = 'fr' } = Astro.props;
const compte = data.par_secteur;
const px = prefix(lang);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const rel = (path.startsWith('/en') ? path.slice(3) : path) || '/'; // chemin sans préfixe langue
const estActif = (sec) => (sec === '/' ? rel === '/' : rel.startsWith(sec));

const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '');
const ogImage = new URL('/og.png', Astro.site).href;
const autreLang = lang === 'fr' ? 'en' : 'fr';
const autreHref = otherLangPath(Astro.url.pathname);
const autreCanon = new URL(autreHref, Astro.site).href.replace(/\/$/, '');
const xDefault = lang === 'fr' ? canonical : autreCanon; // le FR fait foi
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={autreLang} href={autreCanon} />
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="alternate" type="application/rss+xml" title="Concerts Morbihan" href="/flux.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0c14" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#contenu">{lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
    <header class="site-header" transition:persist>
      <div class="masthead">
        <a href={px || '/'} class="marque">
          <span class="marque-pastille" aria-hidden="true"></span>
          Concerts&nbsp;<em>Morbihan</em>
        </a>
        <nav class="masthead-nav" aria-label="Navigation">
          <a href={px || '/'} aria-current={estActif('/') ? 'page' : undefined}>{t(lang, 'nav.concerts')}</a>
          <a href={`${px}/ce-week-end`} aria-current={estActif('/ce-week-end') ? 'page' : undefined}>{t(lang, 'nav.weekend')}</a>
          <a href={`${px}/salles`} aria-current={estActif('/salles') ? 'page' : undefined}>{t(lang, 'nav.venues')}</a>
          <a href={`${px}/a-propos`} aria-current={estActif('/a-propos') ? 'page' : undefined}>{t(lang, 'nav.about')}</a>
          <a href={autreHref} class="lang-bascule" aria-label={lang === 'fr' ? 'Switch to English' : 'Passer en français'}>{autreLang.toUpperCase()}</a>
        </nav>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="pied">
      <div class="pied-inner">
        <p class="pied-titre">Concerts Morbihan</p>
        <p>{t(lang, 'foot.tagline')}</p>
        <nav class="pied-secteurs" aria-label={t(lang, 'foot.byArea')}>
          {SECTEURS.filter((s) => (compte[s.slug] ?? 0) > 0).map((s) => (
            <a href={`${px}/${s.slug}`}>{s.nom} <span>{compte[s.slug]}</span></a>
          ))}
        </nav>
        <p class="pied-suivre">
          {t(lang, 'foot.follow')}
          <a href="/flux.xml">{t(lang, 'foot.rss')}</a> ·
          <a href="/concerts.ics">{t(lang, 'foot.ics')}</a>
        </p>
        <p class="pied-sources">
          {lang === 'fr' ? 'Données : ' : 'Data: '}
          <a href="https://openagenda.com" rel="noopener">OpenAgenda</a>,
          {lang === 'fr' ? ' sites des salles & ' : ' venue sites & '}
          <a href="https://www.fnacspectacles.com" rel="noopener">Fnac Spectacles</a>.
          {lang === 'fr'
            ? ' Affiches © leurs ayants droit. Vérifiez dates & billetterie auprès de l\'organisateur.'
            : ' Posters © their respective owners. Always check dates & tickets with the organiser.'}
        </p>
      </div>
    </footer>

    <script is:inline>
      if (!window.__scrollHdr) {
        window.__scrollHdr = true;
        const onScroll = () =>
          document.body.classList.toggle('scrolled', window.scrollY > 60);
        addEventListener('scroll', onScroll, { passive: true });
        document.addEventListener('astro:after-swap', onScroll);
        onScroll();
      }
    </script>
  </body>
</html>
