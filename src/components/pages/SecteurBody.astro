---
import Base from '../../layouts/Base.astro';
import Concerts from '../Concerts.astro';
import EventsJsonLd from '../EventsJsonLd.astro';
import { SECTEURS, VOISINS } from '../../data/secteurs.js';
import { t, prefix } from '../../i18n.js';
import data from '../../data/events.json';

interface Props { lang?: string; secteur: { slug: string; nom: string } }
const { lang = 'fr', secteur } = Astro.props;
const px = prefix(lang);
const events = data.events.filter((e) => e.secteur === secteur.slug);

// Secteur sans date : on propose les concerts des secteurs voisins plutôt
// qu'une page vide (les données sont triées par date, on garde l'ordre).
const voisins = events.length === 0 ? (VOISINS[secteur.slug] ?? []) : [];
const proches = voisins.length
  ? data.events.filter((e) => voisins.includes(e.secteur)).slice(0, 8)
  : [];

const titre = lang === 'fr'
  ? `Concerts à ${secteur.nom} — agenda Morbihan`
  : `Gigs in ${secteur.nom} — Morbihan guide`;
const description = lang === 'fr'
  ? `Les concerts à venir sur le secteur de ${secteur.nom} (Morbihan) : dates, lieux et billetterie.`
  : `Upcoming gigs in the ${secteur.nom} area (Morbihan): dates, venues and tickets.`;
---

<Base titre={titre} description={description} lang={lang}>
  {events.length > 0 && <EventsJsonLd events={events} />}
  <section class="hero">
    <p class="hero-eyebrow"><a href={px || '/'} class="hero-retour">{t(lang, 'back')}</a> · {t(lang, 'sector.eyebrow')}</p>
    <h1 class="hero-title"><span class="accent">{secteur.nom}.</span></h1>
    <p class="hero-sub">{t(lang, 'sector.sub', events.length)}</p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="section-title">{t(lang, 'sector.upcoming')}</h2>
      <span class="section-count">{t(lang, 'sector.count', events.length)}</span>
    </div>
    <Concerts events={events} lang={lang} />

    {proches.length > 0 && (
      <div class="proches">
        <h2 class="section-title">{t(lang, 'sector.nearby')}</h2>
        <Concerts events={proches} lang={lang} />
      </div>
    )}
  </section>
</Base>
