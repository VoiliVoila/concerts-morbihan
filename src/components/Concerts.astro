---
import { formatBadge, formatHeure } from '../data/format.js';
import { t } from '../i18n.js';

interface Concert {
  id: string;
  titre: string;
  debut: string;
  ville: string;
  lieu: string;
  description?: string;
  image: string | null;
  url: string | null;
}
interface Props {
  events: Concert[];
  lang?: string;
}
const { events, lang = 'fr' } = Astro.props;

// Color palette for genre tags (deterministic per genre).
const PALETTE = ['#ff5d3b', '#ffd166', '#5ad1c8', '#c08bff', '#ff8fab', '#7bd389'];
function couleurGenre(g: string) {
  let h = 0;
  for (let i = 0; i < g.length; i++) h = (h * 31 + g.charCodeAt(i)) >>> 0;
  return PALETTE[h % PALETTE.length];
}
// Extracts up to 3 short genres from the description field (e.g. "electro, folk-rock, punk").
function genres(desc?: string): string[] {
  if (!desc || desc.length > 42 || desc.includes('.')) return [];
  return desc.split(/[,/]/).map((s) => s.trim()).filter(Boolean).slice(0, 3);
}
---

{events.length === 0 ? (
  <p class="vide">{t(lang, 'list.empty')}</p>
) : (
  <div class="liste">
    {events.map((e) => {
      const heure = formatHeure(e.debut);
      const tags = genres(e.description);
      return (
        <a class="carte" href={e.url ?? '#'} target="_blank" rel="noopener" data-secteur={e.secteur} data-debut={e.debut}>
          <div class="carte-media">
            {e.image ? (
              <img src={e.image} alt={`Affiche : ${e.titre}`} loading="lazy" decoding="async" width="600" height="800" />
            ) : (
              <div class="carte-vide">{e.titre}</div>
            )}
          </div>
          <div class="carte-corps">
            <span class="carte-date">
              {formatBadge(e.debut, lang)}{heure && <span class="carte-heure"> · {heure}</span>}
            </span>
            {tags.length > 0 && (
              <div class="carte-genres">
                {tags.map((g) => <span class="pastille" style={`--g:${couleurGenre(g)}`}>{g}</span>)}
              </div>
            )}
            <p class="carte-titre">{e.titre}</p>
            <span class="carte-lieu">{e.lieu ? `${e.lieu} — ` : ''}{e.ville}</span>
          </div>
        </a>
      );
    })}
  </div>
)}
